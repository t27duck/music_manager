{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicManager",
  "mainBinaryName": "music-manager",
  "version": "0.1.0",
  "identifier": "com.t27duck.musicmanager",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MusicManager",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Audio",
    "shortDescription": "Local MP3 library manager",
    "longDescription": "Browse, filter, tag and reorganize a local MP3 library.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
