<div id="sync_status"
     data-controller="sync-status"
     data-sync-status-running-value="<%= status&.running? || false %>"
     data-sync-status-url-value="<%= sync_path %>">
  <% if status.present? %>
    <div class="border-b border-surface-800 bg-surface-900"
         <%= "data-controller=auto-hide" if status.completed? %>
         data-auto-hide-delay-value="5000">
      <div class="container mx-auto px-5 py-3">
        <div class="flex items-baseline justify-between gap-4 text-sm">
          <span class="font-medium <%= sync_status_color(status) %>">
            <%= sync_status_message(status) %>
          </span>

          <span class="shrink-0 tabular-nums text-surface-400" aria-hidden="true">
            <%= status.to_progress %>
          </span>
        </div>

        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-surface-800"
             role="progressbar"
             aria-valuenow="<%= status.percent %>"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-label="Library sync progress">
          <div class="h-full rounded-full transition-[width] duration-300 ease-out <%= sync_bar_color(status) %>"
               style="width: <%= status.percent %>%"></div>
        </div>

        <% if status.filename.present? %>
          <p class="mt-1.5 truncate text-xs text-surface-500"><%= status.filename %></p>
        <% end %>

        <% if status.errors? %>
          <p class="mt-1.5 text-xs text-amber-400">
            <%= pluralize(status.errors.size, "file") %> could not be imported
          </p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
