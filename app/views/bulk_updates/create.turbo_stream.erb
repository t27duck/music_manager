<%= turbo_stream.update "modal", "" %>

<%= turbo_stream.replace "songs" do %>
  <%= turbo_frame_tag "songs", data: { turbo_action: "advance" } do %>
    <%= render "songs/list", songs: @songs, query: @query %>
  <% end %>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast",
        level: @result.any_failures? ? :warning : :notice,
        message: @result.summary %>
<% end %>

<% @result.failures.first(3).each do |failure| %>
  <%= turbo_stream.append "toasts" do %>
    <%= render "shared/toast", level: :alert,
          message: "#{failure.song.title}: #{failure.message}" %>
  <% end %>
<% end %>
