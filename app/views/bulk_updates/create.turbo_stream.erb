<%# The changes are applied in the background -- each one rewrites the song's
    ID3 tags, which is a whole-file rewrite. This only dismisses the modal and
    says the work has started; progress/_update reports the outcome and
    refreshes the list when the job finishes. %>
<%= turbo_stream.update "modal", "" %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast", level: :notice,
        message: "Updating #{pluralize(@selected_songs.size, 'song')}…" %>
<% end %>
