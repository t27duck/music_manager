<%# The moves happen in the background, so this only dismisses the modal and
    says the work has started. The song list is not replaced here -- nothing has
    moved yet. progress/_update refreshes it when the job finishes, which
    reloads each viewer's own URL and so preserves their filters and page. %>
<%= turbo_stream.update "modal", "" %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast", level: :notice,
        message: "Organizing #{pluralize(@selected_songs.size, 'file')}…" %>
<% end %>
