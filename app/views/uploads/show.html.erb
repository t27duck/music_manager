<% content_for :title, "Upload" %>

<div class="mb-5">
  <h1 class="text-2xl font-semibold tracking-tight">Upload</h1>
  <p class="mt-1 text-sm text-surface-400">
    Files are saved to <code class="rounded bg-surface-850 px-1.5 py-0.5 text-surface-300"><%= Upload::DESTINATION %>/</code>
    inside your library, keeping the folder structure you drop.
  </p>
</div>

<div class="mx-auto max-w-3xl space-y-4"
     data-controller="upload"
     data-upload-url-value="<%= upload_path %>">

  <div class="card flex flex-col items-center gap-3 border-2 border-dashed border-surface-700 px-6 py-14 text-center transition"
       data-upload-target="dropzone"
       data-action="dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop">

    <span class="text-4xl text-surface-700" aria-hidden="true">&#8681;</span>

    <p class="text-surface-200">Drop MP3 files or folders here</p>

    <div class="flex flex-wrap justify-center gap-2">
      <button type="button" class="btn" data-action="upload#browseFiles">Choose files</button>
      <button type="button" class="btn" data-action="upload#browseFolder">Choose folder</button>
    </div>

    <%# Hidden inputs are the click-to-browse fallback for the dropzone. %>
    <input type="file" multiple accept="audio/mpeg,.mp3" class="sr-only"
           aria-label="MP3 files to upload"
           data-upload-target="input"
           data-action="upload#chosen">

    <input type="file" multiple webkitdirectory class="sr-only"
           aria-label="Folder of MP3 files to upload"
           data-upload-target="folderInput"
           data-action="upload#chosen">
  </div>

  <div class="card px-5 py-4" data-upload-target="progress" hidden>
    <div class="mb-2 flex items-baseline justify-between gap-4 text-sm">
      <span class="font-medium text-accent-400" data-upload-target="label">Uploading…</span>
      <span class="tabular-nums text-surface-400" data-upload-target="counter">0 / 0</span>
    </div>

    <div class="h-1.5 overflow-hidden rounded-full bg-surface-800"
         role="progressbar" aria-label="Upload progress">
      <div class="h-full rounded-full bg-accent-500 transition-[width] duration-200 ease-out"
           style="width: 0%" data-upload-target="bar"></div>
    </div>

    <p class="mt-3 text-sm font-medium text-emerald-400" data-upload-target="summary" hidden></p>

    <div class="mt-3 max-h-56 space-y-0.5 overflow-y-auto rounded-md border border-surface-800 bg-surface-950 px-3 py-2 font-mono text-xs"
         aria-live="polite"
         data-upload-target="log"></div>
  </div>
</div>
