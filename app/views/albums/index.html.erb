<% content_for :title, "Albums" %>

<div class="mb-5">
  <h1 class="text-2xl font-semibold tracking-tight">Albums</h1>
</div>

<%= render "albums/search", search: @search %>

<%# The count lives inside the frame so it can never disagree with the cards
    currently rendered -- searching and paging replace both together. %>
<%= turbo_frame_tag "albums", data: { turbo_action: "advance" } do %>
  <%= render "albums/list", albums: @albums, search: @search %>
<% end %>
