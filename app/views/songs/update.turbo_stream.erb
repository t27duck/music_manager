<%# Dismiss the modal, then re-render the list so filters, sorting and the
    current page all reflect the change. %>
<%= turbo_stream.update "modal", "" %>

<%= turbo_stream.replace "songs" do %>
  <%= turbo_frame_tag "songs", data: { turbo_action: "advance" } do %>
    <%= render "songs/list", songs: @songs, query: @query %>
  <% end %>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast", level: :notice, message: "Updated #{@song.title}." %>
<% end %>
