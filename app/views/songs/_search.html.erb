<%= search_form_for query,
      url: songs_path,
      html: {
        class: "mb-5",
        data: {
          controller: "auto-submit",
          turbo_frame: "songs",
          # Only `input`. Binding `change` here too would resubmit whenever a
          # text field lost focus -- including when the user clicks a row
          # checkbox, which would re-render the list and wipe their selection.
          action: "input->auto-submit#search"
        }
      } do |form| %>

  <div class="flex flex-wrap items-center gap-3">
    <div class="relative min-w-64 flex-1">
      <%= form.search_field :text_contains,
            placeholder: "Search title, artist, album or genre…",
            autocomplete: "off",
            class: "input pr-9",
            data: { auto_submit_target: "query" } %>

      <button type="button"
              class="absolute inset-y-0 right-0 px-3 text-surface-500 transition hover:text-surface-200"
              aria-label="Clear search"
              <%= "hidden" if query.text_contains.blank? %>
              data-auto-submit-target="clear"
              data-action="auto-submit#clearQuery">&times;</button>
    </div>

    <%= link_to "Reset", songs_path,
          class: "btn", hidden: !filters_active?(query),
          data: { turbo_frame: "songs", auto_submit_target: "reset" } %>
  </div>

  <details class="card mt-3 px-4 py-3" <%= "open" if advanced_filters_active?(query) %>>
    <summary class="cursor-pointer text-sm font-medium text-surface-300 select-none">
      Advanced filters
    </summary>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <%= form.label :title_contains, "Title", class: "label" %>
        <%= form.search_field :title_contains, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :artist_contains, "Artist", class: "label" %>
        <%= form.search_field :artist_contains, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :album_contains, "Album", class: "label" %>
        <%= form.search_field :album_contains, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :genre_contains, "Genre", class: "label" %>
        <%= form.search_field :genre_contains, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :year_eq, "Year", class: "label" %>
        <%= form.search_field :year_eq, class: "input", autocomplete: "off", inputmode: "numeric" %>
      </div>

      <div>
        <%= form.label :file_path_contains, "File path", class: "label" %>
        <%= form.search_field :file_path_contains, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :missing_metadata, "Missing metadata", class: "label" %>
        <%# Discrete choice, so it submits at once rather than on the text debounce. %>
        <%= form.select :missing_metadata,
              Song::MISSING_METADATA_FIELDS.map { |field| [ "No #{field.humanize.downcase}", field ] },
              { include_blank: "Any" },
              class: "input", data: { action: "auto-submit#submit" } %>
      </div>
    </div>

    <div class="mt-4 flex justify-end">
      <button type="button" class="btn" data-action="auto-submit#reset">Clear filters</button>
    </div>
  </details>
<% end %>
