<%= search_form_for query,
      url: songs_path,
      html: {
        class: "mb-5",
        data: {
          controller: "filter-form",
          turbo_frame: "songs",
          action: "input->filter-form#search change->filter-form#submit"
        }
      } do |form| %>

  <div class="flex flex-wrap items-center gap-3">
    <div class="relative min-w-64 flex-1">
      <%= form.search_field :title_or_artist_or_album_or_genre_cont,
            placeholder: "Search title, artist, album or genre…",
            autocomplete: "off",
            class: "input pr-9",
            data: { filter_form_target: "query" } %>

      <button type="button"
              class="absolute inset-y-0 right-0 px-3 text-surface-500 transition hover:text-surface-200"
              aria-label="Clear search"
              <%= "hidden" if query.title_or_artist_or_album_or_genre_cont.blank? %>
              data-filter-form-target="clear"
              data-action="filter-form#clearQuery">&times;</button>
    </div>

    <%= link_to "Reset", songs_path,
          class: "btn", hidden: !filters_active?(query),
          data: { turbo_frame: "songs", filter_form_target: "reset" } %>
  </div>

  <details class="card mt-3 px-4 py-3" <%= "open" if advanced_filters_active?(query) %>>
    <summary class="cursor-pointer text-sm font-medium text-surface-300 select-none">
      Advanced filters
    </summary>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <%= form.label :title_cont, "Title", class: "label" %>
        <%= form.search_field :title_cont, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :artist_cont, "Artist", class: "label" %>
        <%= form.search_field :artist_cont, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :album_cont, "Album", class: "label" %>
        <%= form.search_field :album_cont, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :genre_cont, "Genre", class: "label" %>
        <%= form.search_field :genre_cont, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :year_eq, "Year", class: "label" %>
        <%= form.search_field :year_eq, class: "input", autocomplete: "off", inputmode: "numeric" %>
      </div>

      <div>
        <%= form.label :file_path_contains, "File path", class: "label" %>
        <%= form.search_field :file_path_contains, class: "input", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :missing_metadata, "Missing metadata", class: "label" %>
        <%= form.select :missing_metadata,
              Song::MISSING_METADATA_FIELDS.map { |field| [ "No #{field.humanize.downcase}", field ] },
              { include_blank: "Any" },
              class: "input" %>
      </div>
    </div>

    <div class="mt-4 flex justify-end">
      <button type="button" class="btn" data-action="filter-form#reset">Clear filters</button>
    </div>
  </details>
<% end %>
