<%= turbo_stream.replace dom_id(@song, :album_art) do %>
  <%= render "songs/album_arts/panel", song: @song, error: @error %>
<% end %>

<% if @error.blank? %>
  <%# Keep the row's thumbnail in step with the art just changed. %>
  <%= turbo_stream.replace dom_id(@song) do %>
    <%= render "songs/song", song: @song %>
  <% end %>

  <%= turbo_stream.append "toasts" do %>
    <%= render "shared/toast", level: :notice,
          message: @song.album_art? ? "Album art updated." : "Album art removed." %>
  <% end %>
<% end %>
