<tr id="<%= dom_id(song) %>" class="group transition hover:bg-surface-850/60">
  <td class="py-2 pl-4 pr-2">
    <%= check_box_tag "song_ids[]", song.id, false,
          id: dom_id(song, :select),
          class: "size-4 rounded border-surface-600 bg-surface-900 text-accent-500 focus:ring-accent-500",
          aria: { label: "Select #{song.title}" },
          data: { selection_target: "checkbox", action: "selection#refresh" } %>
  </td>

  <td class="py-2 pl-1 pr-0">
    <%= render "songs/album_arts/preview", song: song, size: :small %>
  </td>

  <td class="max-w-xs px-4 py-2.5 font-medium text-surface-100" title="<%= song.relative_path %>">
    <%= render "songs/fields/field", song: song, name: "title" %>
  </td>
  <td class="max-w-xs px-4 py-2.5"><%= render "songs/fields/field", song: song, name: "artist" %></td>
  <td class="max-w-xs px-4 py-2.5"><%= render "songs/fields/field", song: song, name: "album" %></td>
  <td class="px-4 py-2.5"><%= render "songs/fields/field", song: song, name: "genre" %></td>
  <td class="px-4 py-2.5 tabular-nums"><%= render "songs/fields/field", song: song, name: "year" %></td>
  <td class="px-4 py-2.5 text-right tabular-nums text-surface-400"><%= formatted_track song %></td>
  <td class="px-4 py-2.5 text-right tabular-nums text-surface-400"><%= formatted_duration song.duration %></td>

  <td class="px-4 py-2.5 text-right">
    <%# Always visible rather than hover-only: a hover-only action is invisible
        on touch devices and hard to discover anywhere. %>
    <%= link_to "Edit", edit_song_path(song, **list_state_params),
          class: "rounded-md px-2 py-1 text-xs font-medium text-surface-500 transition hover:bg-surface-800 hover:text-accent-400 group-hover:text-accent-400",
          data: { turbo_frame: "modal" } %>
  </td>
</tr>
