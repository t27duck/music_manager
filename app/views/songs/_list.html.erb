<%# The modal URLs live here, inside the frame, rather than on the selection
    controller outside it: they carry the current filter, so they have to be
    re-rendered whenever the filter changes. Held on the controller they would
    be stale the moment a search re-rendered the list beneath it. %>
<div data-selection-target="state"
     data-bulk-url="<%= new_bulk_update_path(**list_state_params) %>"
     data-organize-url="<%= new_file_organization_path(**list_state_params) %>"
     data-matching-count="<%= songs.total_count %>">
  <div class="mb-3 flex min-h-8 flex-wrap items-center justify-between gap-3">
    <%# Announced so a screen reader hears the result of a filter, which
        otherwise changes the table silently. %>
    <p class="text-sm text-surface-400" id="songs_count" aria-live="polite">
      <%= render "songs/count", songs: songs %>
    </p>

    <div class="flex items-center gap-2" data-selection-target="actions" hidden>
      <span class="text-sm text-surface-300">
        <span data-selection-target="count">0</span> selected
      </span>

      <button type="button" class="btn btn-primary" data-action="selection#edit">Edit selected</button>
      <button type="button" class="btn" data-action="selection#organize">Organize files</button>
      <button type="button" class="btn" data-action="selection#clear">Clear</button>
    </div>
  </div>

  <%# Offered only once the whole page is ticked and there is more to widen to,
      so touching the entire library always takes two deliberate clicks. %>
  <div class="mb-3 rounded-md border border-accent-800 bg-surface-850 px-4 py-2 text-sm text-surface-300"
       data-selection-target="banner" hidden>
    All <%= number_with_delimiter(songs.size) %> songs on this page are selected.
    <button type="button" class="font-medium text-accent-400 underline transition hover:text-accent-300"
            data-action="selection#selectAllMatching">
      Select all <%= number_with_delimiter(songs.total_count) %> matching
    </button>
  </div>

  <% if songs.any? %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <%# table-fixed so the columns divide the available width and the cells
            can truncate; without it a two-hundred-character artist tag pushes
            the last columns off the screen. Every column but the title is a
            fixed width, and min-w is their sum plus a usable title, so the
            title can never be squeezed to nothing on a narrow screen -- the
            wrapper scrolls sideways instead. %>
        <table class="w-full min-w-[1020px] table-fixed text-left text-sm" aria-label="Songs">
          <thead class="border-b border-surface-800 bg-surface-850 text-xs tracking-wide text-surface-400 uppercase">
            <tr>
              <th scope="col" class="w-10 py-3 pl-4 pr-2">
                <%= check_box_tag "toggle_all", "1", false,
                      class: "size-4 rounded border-surface-600 bg-surface-900 text-accent-500 focus:ring-accent-500",
                      aria: { label: "Select all songs on this page" },
                      data: { selection_target: "toggleAll", action: "selection#toggleAll" } %>
              </th>
              <th scope="col" class="w-14 py-3 pl-1 pr-0"><span class="sr-only">Album art</span></th>
              <th scope="col" class="px-4 py-3 font-medium"><%= sort_header query, :title, "Title" %></th>
              <th scope="col" class="w-44 px-4 py-3 font-medium"><%= sort_header query, :artist, "Artist" %></th>
              <th scope="col" class="w-44 px-4 py-3 font-medium"><%= sort_header query, :album, "Album" %></th>
              <th scope="col" class="w-24 px-4 py-3 font-medium"><%= sort_header query, :genre, "Genre" %></th>
              <th scope="col" class="w-16 px-4 py-3 font-medium"><%= sort_header query, :year, "Year" %></th>
              <th scope="col" class="w-16 px-4 py-3 text-right font-medium"><%= sort_header query, :track_number, "Track" %></th>
              <th scope="col" class="w-20 px-4 py-3 text-right font-medium"><%= sort_header query, :duration, "Length" %></th>
              <th scope="col" class="w-16 px-4 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-surface-800">
            <%= render partial: "songs/song", collection: songs %>
          </tbody>
        </table>
      </div>
    </div>

    <%= paginate songs %>
  <% elsif filters_active?(query) %>
    <%= render "songs/no_results" %>
  <% else %>
    <%= render "songs/empty" %>
  <% end %>
</div>
