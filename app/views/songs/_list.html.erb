<p class="mb-3 text-sm text-surface-400" id="songs_count">
  <%= render "songs/count", songs: songs %>
</p>

<% if songs.any? %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-surface-800 bg-surface-850 text-xs tracking-wide text-surface-400 uppercase">
          <tr>
            <th scope="col" class="py-3 pl-4 pr-0"><span class="sr-only">Album art</span></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= sort_header query, :title, "Title" %></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= sort_header query, :artist, "Artist" %></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= sort_header query, :album, "Album" %></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= sort_header query, :genre, "Genre" %></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= sort_header query, :year, "Year" %></th>
            <th scope="col" class="px-4 py-3 text-right font-medium"><%= sort_header query, :track_number, "Track" %></th>
            <th scope="col" class="px-4 py-3 text-right font-medium"><%= sort_header query, :duration, "Length" %></th>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>

        <tbody class="divide-y divide-surface-800">
          <%= render partial: "songs/song", collection: songs %>
        </tbody>
      </table>
    </div>
  </div>

  <%= paginate songs %>
<% elsif filters_active?(query) %>
  <%= render "songs/no_results" %>
<% else %>
  <%= render "songs/empty" %>
<% end %>
